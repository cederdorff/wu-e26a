<p:notes xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" showMasterSp="1" showMasterPhAnim="1"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="1129" name="Shape 1129"/><p:cNvSpPr/><p:nvPr><p:ph type="sldImg"/></p:nvPr></p:nvSpPr><p:spPr><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="1130" name="Shape 1130"/><p:cNvSpPr/><p:nvPr><p:ph type="body" sz="quarter" idx="1"/></p:nvPr></p:nvSpPr><p:spPr><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr/><a:r><a:t>Minimalistisk framework:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Express er et letvægts og minimalistisk webapplikationsframework til Node.js.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Routing:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Det tilbyder et kraftfuldt rutingsystem til at håndtere forskellige HTTP-metoder og URL-mønstre.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Middleware:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Express bruger middleware til at håndtere forskellige opgaver som autentifikation, logning og dataparsing.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>HTTP hjælpefunktioner:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Giver nemt anvendelige metoder til interaktion med HTTP-protokollen.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Udvidelighed:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Tillader integration af tredjeparts middleware og udvidelser for ekstra funktionalitet.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Servering af statiske filer:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Forenkler servering af statiske filer som CSS, JavaScript og billeder.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Fejlhåndtering:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Tilbyder mekanismer til fejlhåndtering for en bedre brugeroplevelse.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Fleksibel til API'er:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Egnet til at bygge RESTful API'er med dets routing- og middleware-funktioner.</a:t></a:r></a:p><a:p><a:pPr/></a:p><a:p><a:pPr/><a:r><a:t>Brugervenlig:</a:t></a:r></a:p><a:p><a:pPr/><a:r><a:t>Express.js er let at bruge og kræver minimal konfiguration, hvilket gør det ideelt for udviklere, der ønsker at bygge webapplikationer hurtigt.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>
