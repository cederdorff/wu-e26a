<p:txBody><a:bodyPr anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>Single-page applications (SPAs)</a:t></a:r><a:br/><a:r><a:t>Express.js creates SPAs that load all resources on a single page, ensuring a seamless user experience.</a:t></a:r></a:p><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>Mobile applications</a:t></a:r><a:br/><a:r><a:t>Express.js builds mobile apps using web technologies like HTML, CSS, and JavaScript.</a:t></a:r></a:p><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>RESTful APIs</a:t></a:r><a:br/><a:r><a:t>Express.js crafts RESTful APIs for data manipulation and access by other applications.</a:t></a:r></a:p><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>Server-side rendering</a:t></a:r><a:br/><a:r><a:t>Express.js enables server-side rendering, rendering pages on the server before sending to the client.</a:t></a:r></a:p><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>Real-time applications</a:t></a:r><a:br/><a:r><a:t>Express.js constructs real-time apps, facilitating ongoing client-server communication.</a:t></a:r></a:p><a:p><a:pPr marL="407193" indent="-407193" algn="just" defTabSz="470534"><a:spcBef><a:spcPts val="2200"/></a:spcBef><a:buSzPct val="125000"/><a:buChar char="•"/><a:defRPr spc="153" sz="3078"/></a:pPr><a:r><a:rPr b="1"/><a:t>Microservices</a:t></a:r><a:br/><a:r><a:t>Express.js constructs microservices, small independent units combined to create larger applications.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr><mc:AlternateContent xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"><mc:Choice xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" Requires="p14"><p:transition spd="fast" advClick="1" p14:dur="200"><p:fade/></p:transition></mc:Choice><mc:Fallback><p:transition spd="fast"><p:fade/></p:transition></mc:Fallback></mc:AlternateContent></p:sld>
